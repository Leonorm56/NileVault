{
  "name": "nile-vault",
  "version": "1.0.1",
  "description": "NileVault — Standalone TON wallet for the Nile ecosystem",
  "main": "src/main.js",
  "scripts": {
    "start": "vite build && electron .",
    "dev": "vite build && electron .",
    "build:web-preview": "cross-env VITE_PREVIEW=1 vite build --outDir app-preview",
    "serve:web-preview": "node preview-server.cjs",
    "build": "vite build && npm run check:build && electron-builder --win",
    "build:portable": "vite build && npm run check:build && electron-builder --win portable",
    "check:build": "node scripts/check-build.mjs",
    "test": "npm run test:send && npm run test:backup",
    "test:send": "esbuild tests/send.test.mjs --bundle --platform=node --format=cjs --packages=external --outfile=tests/.build/send.test.cjs --log-level=warning && node tests/.build/send.test.cjs",
    "test:backup": "esbuild tests/backup.test.mjs --bundle --platform=node --format=cjs --packages=external --outfile=tests/.build/backup.test.cjs --log-level=warning && node tests/.build/backup.test.cjs",
    "verify:live": "esbuild scripts/live-verify.mjs --bundle --platform=node --format=esm --packages=external --outfile=tests/.build/live-verify.mjs --log-level=warning && node tests/.build/live-verify.mjs",
    "verify:funded": "esbuild scripts/funded-verify.mjs --bundle --platform=node --format=esm --packages=external --outfile=tests/.build/funded-verify.mjs --log-level=warning && node tests/.build/funded-verify.mjs"
  },
  "dependencies": {
    "@fontsource/fira-code": "^5.2.7",
    "@fontsource/noto-sans": "^5.2.10",
    "@fontsource/turret-road": "^5.2.7",
    "@noble/ciphers": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "@scure/base": "^2.2.0",
    "@tanstack/react-query": "^5.100.9",
    "@ton/core": "^0.63.1",
    "@ton/crypto": "^3.3.0",
    "@ton/ton": "^16.2.4",
    "buffer": "^6.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "copy-to-clipboard": "^4.0.2",
    "qrcode.react": "^4.2.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-hot-toast": "^2.6.0",
    "react-icons": "^5.6.0",
    "tailwind-merge": "^3.5.0",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.4",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^41.7.0",
    "electron-builder": "^25.0.0",
    "png-to-ico": "^3.0.2",
    "tailwindcss": "^4.2.4",
    "vite": "^6.0.0",
    "vite-plugin-node-polyfills": "^0.28.0"
  },
  "build": {
    "appId": "com.nilevault.app",
    "productName": "NileVault",
    "compression": "normal",
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName} Setup ${version}.${ext}"
    },
    "files": [
      "src/**/*",
      "app/**/*"
    ],
    "extraResources": []
  }
}
